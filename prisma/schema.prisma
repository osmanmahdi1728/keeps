generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts             Account[]
  sessions             Session[]
  merchant             Merchant?
  passwordResetTokens  PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Merchant {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  slug            String   @unique
  logoUrl         String?
  primaryColor    String   @default("#1c1914")
  backgroundColor String   @default("#f4efe6")
  accentColor     String   @default("#c45c26")
  gradientEnd     String   @default("#e4d3b8")
  fontFamily      String   @default("fraunces")
  templateId      String   @default("cream")
  siteTemplate    String   @default("storefront")
  siteKind        String   @default("cafe")
  neighborhood    String   @default("")
  hours           String   @default("Open daily")
  knownFor        String   @default("")
  instagram       String   @default("")
  tagline         String   @default("")
  about           String   @default("")
  sitePublished   Boolean  @default(true)
  siteVersion     Int      @default(1)
  googlePlaceId   String?
  placeSyncedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  program         Program?
  siteSections    SiteSection[]
  siteMedia       SiteMedia[]
  siteMenuItems   SiteMenuItem[]
  placeSnapshot   GooglePlaceSnapshot?

  @@index([googlePlaceId])
}

model SiteSection {
  id         String         @id @default(cuid())
  merchantId String
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  key        String
  type       String
  position   Int            @default(0)
  enabled    Boolean        @default(true)
  content    Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  media      SiteMedia[]
  menuItems  SiteMenuItem[]

  @@unique([merchantId, key])
  @@index([merchantId, position])
  @@index([merchantId, type])
}

model SiteMedia {
  id         String       @id @default(cuid())
  merchantId String
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    SiteSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  key        String
  kind       String       @default("image")
  url        String       @db.Text
  alt        Json
  position   Int          @default(0)
  width      Int?
  height     Int?
  metadata   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  menuItems  SiteMenuItem[]

  @@unique([merchantId, key])
  @@index([merchantId, position])
  @@index([sectionId, position])
}

model SiteMenuItem {
  id          String       @id @default(cuid())
  merchantId  String
  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sectionId   String?
  section     SiteSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  mediaId     String?
  media       SiteMedia?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  key         String
  name        Json
  description Json?
  category    Json?
  priceCents  Int?
  currency    String       @default("CAD")
  position    Int          @default(0)
  available   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([merchantId, key])
  @@index([merchantId, position])
  @@index([sectionId, position])
  @@index([mediaId])
}

model GooglePlaceSnapshot {
  id         String   @id @default(cuid())
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  placeId    String
  payload    Json
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([placeId])
}

model Program {
  id             String     @id @default(cuid())
  merchantId     String     @unique
  merchant       Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  stampsRequired Int        @default(10)
  rewardLabel    String     @default("Free item")
  description    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  customers      Customer[]
  campaigns      Campaign[]
}

model Customer {
  id                String    @id @default(cuid())
  programId         String
  program           Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  email             String
  name              String
  locale            String    @default("en")
  marketingOptIn    Boolean   @default(false)
  welcomeOfferRedeemed Boolean @default(false)
  unsubscribeToken  String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  passes            Pass[]

  @@unique([programId, email])
}

model Pass {
  id                 String              @id @default(cuid())
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serial             String              @unique
  platform           String
  stampCount         Int                 @default(0)
  authenticationToken String
  googleObjectId     String?
  lastMessage        String?
  updatedAt          DateTime            @updatedAt
  createdAt          DateTime            @default(now())
  appleRegistrations AppleRegistration[]
  events             StampEvent[]
}

model AppleRegistration {
  id                      String   @id @default(cuid())
  passId                  String
  pass                    Pass     @relation(fields: [passId], references: [id], onDelete: Cascade)
  deviceLibraryIdentifier String
  pushToken               String
  updatedAt               DateTime @updatedAt

  @@unique([passId, deviceLibraryIdentifier])
}

model StampEvent {
  id        String   @id @default(cuid())
  passId    String
  pass      Pass     @relation(fields: [passId], references: [id], onDelete: Cascade)
  type      String
  staffId   String?
  createdAt DateTime @default(now())
}

model Campaign {
  id        String    @id @default(cuid())
  programId String
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  channel   String
  subject   String?
  body      String
  status    String    @default("draft")
  sentCount Int       @default(0)
  createdAt DateTime  @default(now())
  sentAt    DateTime?
}
