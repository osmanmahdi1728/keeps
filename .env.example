# Database (SQLite for local; switch provider to postgresql for production)
DATABASE_URL="file:./dev.db"

# Public origin used in join links, Wallet webServiceURL, and emails
APP_URL="http://localhost:3000"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Email (optional). Without these, sign-in uses the demo password account and emails log to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Keeps <noreply@example.com>"

# Apple Wallet (optional). PEM files encoded as base64. Without these, join uses a preview card.
APPLE_PASS_TYPE_ID="pass.com.example.keeps"
APPLE_TEAM_ID=""
APPLE_PASS_CERT=""
APPLE_PASS_KEY=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT=""

# Google Wallet (optional). Service account JSON as a single line.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
