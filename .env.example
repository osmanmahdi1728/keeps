# Postgres (Neon on Vercel). Locally, paste DATABASE_URL from Vercel → Settings → Env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Public origin used in join links, Wallet webServiceURL, and emails
APP_URL="http://localhost:3000"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Optional. Leave unset on Vercel; trustHost derives the origin from the request.
AUTH_URL="http://localhost:3000"

# Email (optional). Without these, sign-in uses the demo password account and emails log to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Keeps <noreply@example.com>"

# Apple Wallet (optional). PEM files encoded as base64. Without these, join uses a preview card.
APPLE_PASS_TYPE_ID="pass.com.example.keeps"
APPLE_TEAM_ID=""
APPLE_PASS_CERT=""
APPLE_PASS_KEY=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT=""

# Google Wallet (optional). Service account JSON as a single line.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Keep "demo" until Google approves publishing access.
GOOGLE_WALLET_PUBLISHING_STATUS="demo"

# Optional AI polish for the shop one-pager
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="gpt-image-1"

# Persistent image storage (business search uses keyless OpenStreetMap/Nominatim)
BLOB_READ_WRITE_TOKEN=""
